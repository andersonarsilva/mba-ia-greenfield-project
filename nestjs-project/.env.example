# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube <noreply@streamtube.com>"

# Storage (MinIO — S3-compatible, local development)
STORAGE_ENDPOINT=http://minio:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=streamtube
STORAGE_SECRET_ACCESS_KEY=streamtube
STORAGE_BUCKET=streamtube-videos
STORAGE_FORCE_PATH_STYLE=true
STORAGE_PRESIGNED_URL_EXPIRATION_SECONDS=3600
STORAGE_STREAM_URL_EXPIRATION_SECONDS=300

# Queue (RabbitMQ)
QUEUE_URL=amqp://streamtube:streamtube@rabbitmq:5672
QUEUE_EXCHANGE=video
QUEUE_NAME=video-processing
QUEUE_DEAD_LETTER_EXCHANGE=dlx
QUEUE_DEAD_LETTER_QUEUE=video-processing.dlq
QUEUE_MAX_RETRIES=3

# Video processing
ABANDONED_UPLOAD_EXPIRATION_HOURS=24
